PORT=5000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=eims

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Break rule: if an employee works longer than BREAK_THRESHOLD_HOURS,
# BREAK_MINUTES are automatically deducted at time-out (unless a break is given).
BREAK_THRESHOLD_HOURS=5
BREAK_MINUTES=60

# First admin account (used by: npm run seed:admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
